# Copy this file to .env and fill in the two keys. .env is never committed.
# These are ordinary environment variables, so a cloud session can set them in
# its own environment settings instead and leave this file empty.

# Free key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=
# Free key: https://fredaccount.stlouisfed.org/apikey
FRED_API_KEY=

# How much detail the logs show: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Where the database file lives. Relative paths are from the repo root.
DB_PATH=data/controlroom.duckdb
